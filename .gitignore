# What never goes to Git. Rule: code and docs are tracked; data, models, media, environments,
# secrets and machine-local folders are not. The full layout is explained in STRUCTURE.md.

# --- Local folders of this machine (private, see STRUCTURE.md) -----------------------------------
# live workspace: models, AR, API env and scripts, notes, the team repo
/workspace/
# LSF datasets and pose collections
/datasets/
# local web apps: presentation deck, test / comparison sites, AZee explorer
/apps/
# private media: deck PDFs, brand files, demo videos, source media, papers, reports
/assets/
# git worktrees of the feature branches
.worktrees/
# instructions for local coding agents (machine paths)
/CLAUDE.md
/.claude/

# --- Environments, caches, builds ------------------------------------------------------------------
.venv/
.venv-*/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
dist/

# --- Secrets ---------------------------------------------------------------------------------------
.env

# --- Private runtime data, models and generated artifacts -----------------------------------------
.models/
.runtime/
.orchestration/
artifacts/dictasign/
artifacts/avatar-review/
artifacts/phrase-review/
artifacts/collision-review/
artifacts/cv-review/
/data/audit/private/
/data/manifests/*.jsonl
/data/parallel/*.jsonl
/data/poses/*.npz
/data/poses/private/
/research/private/
/research/motion/*preview*.html

# Private phone-transfer setup and generated offline bundles
/integration/portable/
/SignaCulture_offline_*

# Local planning and orchestration documents
/docs/planning/ORCHESTRATION.md
/docs/planning/SignaCulture_AI_Plan_Developpement.md
/docs/presentation/SignaCulture_Full_Pipeline.pdf
/research/paper-b/RESEARCH_BRIEF.md

# graft local code-search cache (regenerable with `graft build`)
/graft/

# Showcase recordings: generated by `node e2e/build-showcase.mjs` from rights-pending clips
site/media/

# Third-party research papers: keep local copies only (copyright)
/research/paper-b/*.pdf

# Demo media cut from the private dataset (never commit)
frontend/public/demo-media/
frontend/public/mediapipe/
