{"annotation_scheme": "UD-FSL-STK-FORM", "document": "LS-Colin_champignon", "french_text": "Comment on fait : D'abord, il faut laver les champignons, tout laver, les couper en morceaux, les mettre dans une passoire.", "gloss_sequence": "[COMMENCER] [COMMENT] [IL-FAUT] [LAVER] [PREMIER]~ [CHAMPIGNON] [LAVER] [COUPER-en-morceaux] [DÉPLACER] SST[forme-plate]~ SST[forme-ronde] [s'égoutter] ??[IL-FAUT]~", "language_variant": "LSF_FR", "license_id": "CC-BY-SA-4.0", "linguistic_review": "PENDING_LOCAL_REVIEW", "pair_id": "stk:LS-Colin_champignon__15", "quality_flags": ["FREE_TRANSLATION", "UD_PARALLEL_NO", "NONMANUALS_NOT_IN_TARGET"], "recording": "https://cocoon.huma-num.fr/data/cuxac/CUC022_low.mp4", "rights_status": "LICENSED_RESEARCH", "source_annotation": "PUBLISHED_EXPERT_ANNOTATION", "source_id": "stk", "source_revision": "d1a6c6487eeddf67a14a5e61116b7cc12a0d1f6a", "source_segment_ids": ["LS-Colin_champignon__15"], "speaker_group": "LS-Colin_champignon:UNKNOWN", "split": "train", "split_group": "component:2621feb3ef63afcb"}
